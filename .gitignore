# Build and generated output
/build/
/out/
/install/
/log/
compile_commands.json

# Local tool/runtime state; keep approved plans
/.codex/
/.omx/*
!/.omx/plans/
!/.omx/plans/*.md

# Editor and OS files
.cache/
/.codegraph/
__pycache__/
*.py[cod]
.idea/
.vscode/
*.swp
*~
.DS_Store

# Target/sysroot material must never enter Git
/sysroots/*
!/sysroots/README.md
!/sysroots/locks/
!/sysroots/locks/*.json
!/sysroots/locks/README.md
*.sysroot.tar*

# Local deployment secrets and inventory overrides
/.env
/config/local/
*.pem
*.key

# Ad-hoc local probe output (CMake output lives under out/)
/tools/platform_probe/main
